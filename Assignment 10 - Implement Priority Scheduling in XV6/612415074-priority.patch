index b22bbd7..639a517 100644
--- a/lapic.c
+++ b/lapic.c
@@ -227,3 +227,13 @@ cmostime(struct rtcdate *r)
   *r = t1;
   r->year += 2000;
 }
+
+// Reload this CPU's local APIC timer. Called by scheduler() before each
+// context switch so the time slice depends on the process's priority.
+void
+lapicsettimer(uint count)
+{
+  if(!lapic)
+    return;
+  lapicw(TICR, count);   // writing TICR restarts the countdown
+}
