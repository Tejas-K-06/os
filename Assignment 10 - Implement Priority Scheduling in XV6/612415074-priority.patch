@@ -532,3 +539,52 @@ procdump(void)
     cprintf("\n");
   }
 }
+
+// Print process table with priorities (used by the ps user program).
+int
+cps(void)
+{
+  struct proc *p;
+  static char *names[] = {
+  [UNUSED]    "unused",
+  [EMBRYO]    "embryo",
+  [SLEEPING]  "sleep",
+  [RUNNABLE]  "runble",
+  [RUNNING]   "run",
+  [ZOMBIE]    "zombie"
+  };
+
+  sti();  // enable interrupts on this processor
+  acquire(&ptable.lock);
+  cprintf("name\tpid\tstate\tpriority\n");
+  for(p = ptable.proc; p < &ptable.proc[NPROC]; p++){
+    if(p->state == UNUSED)
+      continue;
+    cprintf("%s\t%d\t%s\t%d\n", p->name, p->pid, names[p->state], p->priority);
+  }
+  release(&ptable.lock);
+  return 0;
+}
+
+// Change priority of process pid. Returns pid on success, -1 on bad
+// priority or unknown pid.
+int
+chpr(int pid, int priority)
+{
+  struct proc *p;
+  int ret = -1;
+
+  if(priority < MINPRI || priority > MAXPRI)
+    return -1;
+
+  acquire(&ptable.lock);
+  for(p = ptable.proc; p < &ptable.proc[NPROC]; p++){
+    if(p->pid == pid && p->state != UNUSED){
+      p->priority = priority;
+      ret = pid;
+      break;
+    }
+  }
+  release(&ptable.lock);
+  return ret;
+}
diff --git a/proc.h b/proc.h
index 1647114..1c89f7e 100644
--- a/proc.h
+++ b/proc.h
@@ -49,8 +49,15 @@ struct proc {
   struct file *ofile[NOFILE];  // Open files
   struct inode *cwd;           // Current directory
   char name[16];               // Process name (debugging)
+  int priority;                // Scheduling priority: MINPRI (highest) .. MAXPRI (lowest)
 };
 
+// Priority scheduling parameters (lower number = higher priority = longer time slice)
+#define MINPRI 1
+#define MAXPRI 10
+#define DEFPRI 5
+#define BASEQ  10000000   // LAPIC timer count for one quantum unit (same value lapicinit() uses)
+
 // Process memory is laid out contiguously, low addresses first:
 //   text
 //   original data and bss
diff --git a/prtest.c b/prtest.c
new file mode 100644
index 0000000..4f90522
--- /dev/null
+++ b/prtest.c
@@ -0,0 +1,41 @@
+#include "types.h"
+#include "stat.h"
+#include "user.h"
+
+// Forks 4 children; each sets its own priority, burns CPU in a nested
+// loop, prints when it finishes, and exits. Priority 1 gets the longest
+// time slice, so it should finish first; priority 10 last.
+// Adjust OUTER/INNER if it finishes too fast or takes too long.
+#define OUTER 2000
+#define INNER 100000
+
+int
+main(void)
+{
+  int pri[4] = {1, 4, 7, 10};
+  int i, j, k, pid;
+
+  for(i = 0; i < 4; i++){
+    pid = fork();
+    if(pid < 0){
+      printf(1, "prtest: fork failed\n");
+      exit();
+    }
+    if(pid == 0){
+      volatile int x = 0;
+      if(nice(pri[i]) < 0){
+        printf(1, "prtest: nice(%d) failed\n", pri[i]);
+        exit();
+      }
+      for(j = 0; j < OUTER; j++)
+        for(k = 0; k < INNER; k++)
+          x += k;
+      printf(1, "child pid %d priority %d finished at tick %d\n",
+             getpid(), pri[i], uptime());
+      exit();
+    }
+  }
+  for(i = 0; i < 4; i++)
+    wait();
+  exit();
+}
