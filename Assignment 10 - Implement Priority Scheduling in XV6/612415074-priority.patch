diff --git a/sysproc.c b/sysproc.c
index 0686d29..adb1133 100644
--- a/sysproc.c
+++ b/sysproc.c
@@ -89,3 +89,32 @@ sys_uptime(void)
   release(&tickslock);
   return xticks;
 }
+
+int
+sys_cps(void)
+{
+  return cps();
+}
+
+int
+sys_chpr(void)
+{
+  int pid, pr;
+  if(argint(0, &pid) < 0)
+    return -1;
+  if(argint(1, &pr) < 0)
+    return -1;
+  return chpr(pid, pr);
+}
+
+// nice(n): set the calling process's priority to n (MINPRI..MAXPRI).
+int
+sys_nice(void)
+{
+  int n;
+  if(argint(0, &n) < 0)
+    return -1;
+  if(chpr(myproc()->pid, n) < 0)
+    return -1;
+  return 0;
+}
