@@ -343,6 +345,11 @@ scheduler(void)
       switchuvm(p);
       p->state = RUNNING;
 
+      // Time quantum depends on priority: program this CPU's LAPIC timer
+      // so the next timer interrupt (which makes the process yield) comes
+      // after BASEQ * (MAXPRI + 1 - priority) counts.
+      lapicsettimer(BASEQ * (MAXPRI + 1 - p->priority));
