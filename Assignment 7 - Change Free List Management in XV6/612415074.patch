diff --git a/Makefile b/Makefile
index 09d790c..087956d 100644
--- a/Makefile
+++ b/Makefile
@@ -76,7 +76,7 @@ AS = $(TOOLPREFIX)gas
 LD = $(TOOLPREFIX)ld
 OBJCOPY = $(TOOLPREFIX)objcopy
 OBJDUMP = $(TOOLPREFIX)objdump
-CFLAGS = -fno-pic -static -fno-builtin -fno-strict-aliasing -O2 -Wall -MD -ggdb -m32 -Werror -fno-omit-frame-pointer
+CFLAGS = -fno-pic -static -fno-builtin -fno-strict-aliasing -O2 -Wall -MD -ggdb -m32 -fno-omit-frame-pointer
 CFLAGS += $(shell $(CC) -fno-stack-protector -E -x c /dev/null >/dev/null 2>&1 && echo -fno-stack-protector)
 ASFLAGS = -m32 -gdwarf-2 -Wa,-divide
 # FreeBSD ld wants ``elf_i386_fbsd''
diff --git a/kalloc.c b/kalloc.c
index 14cd4f4..5500b8c 100644
--- a/kalloc.c
+++ b/kalloc.c
@@ -13,14 +13,15 @@ void freerange(void *vstart, void *vend);
 extern char end[]; // first address after kernel loaded from ELF file
                    // defined by the kernel linker script in kernel.ld

 struct run {
   struct run *next;
+  struct run *prev;
 };

 struct {
   struct spinlock lock;
   int use_lock;
-  struct run *freelist;
+  struct run *head;
 } kmem;

 // Initialization happens in two phases.
@@ -33,6 +34,7 @@ kinit1(void *vstart, void *vend)
 {
   initlock(&kmem.lock, "kmem");
   kmem.use_lock = 0;
+  kmem.head = 0;
   freerange(vstart, vend);
 }

@@ -59,19 +61,25 @@ freerange(void *vstart, void *vend)
 void
 kfree(char *v)
 {
-  struct run *r;
+  struct run *r;

   if((uint)v % PGSIZE || v < end || V2P(v) >= PHYSTOP)
     panic("kfree");

   // Fill with junk to catch dangling refs.
   memset(v, 1, PGSIZE);

   if(kmem.use_lock)
     acquire(&kmem.lock);
+
   r = (struct run*)v;
+  r->next = kmem.head;
+  r->prev = 0;
+  if(kmem.head)
+    kmem.head->prev = r;
+  kmem.head = r;
+
   if(kmem.use_lock)
     release(&kmem.lock);
 }
@@ -82,15 +90,23 @@ kfree(char *v)
 char*
 kalloc(void)
 {
-  struct run *r;
-
+  struct run *r;
+
   if(kmem.use_lock)
     acquire(&kmem.lock);
-  r = kmem.freelist;
+
+  r = kmem.head;
   if(r)
-    kmem.freelist = r->next;
+    kmem.head = r->next;
+
+  if(kmem.head)
+    kmem.head->prev = 0;
+
   if(kmem.use_lock)
     release(&kmem.lock);
+
   return (char*)r;
 }

