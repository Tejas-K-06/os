diff --git a/proc.c b/proc.c
--- a/proc.c
+++ b/proc.c
@@ -1,0 +1,1 @@
 struct {
   struct spinlock lock;
   struct proc proc[NPROC];
 } ptable;
+
+// Counters requested by the OS lab assignment.
+static struct spinlock ctxtcnt_lock;
+static uint timer_interrupt_count;
+static uint context_switch_count;
@@ -1,0 +1,1 @@
 void
 pinit(void)
 {
   initlock(&ptable.lock, "ptable");
+  initlock(&ctxtcnt_lock, "ctxtcnt");
+  timer_interrupt_count = 0;
+  context_switch_count = 0;
 }
@@ -1,0 +1,1 @@
 void
 scheduler(void)
 {
@@ -1,0 +1,1 @@
       if(p->state == RUNNABLE) {
         // Switch to chosen process.  It is the process's job
         // to release ptable.lock and then reacquire it
         // before jumping back to us.
         c->proc = p;
         switchuvm(p);
         p->state = RUNNING;
+        acquire(&ctxtcnt_lock);
+        context_switch_count++;
+        release(&ctxtcnt_lock);
         swtch(&(c->scheduler), p->context);
         switchkvm();
@@ -1,0 +1,1 @@
 }
+
+// Called once for every timer interrupt handled by trap().
+void
+count_timer_interrupt(void)
+{
+  acquire(&ctxtcnt_lock);
+  timer_interrupt_count++;
+  release(&ctxtcnt_lock);
+}
+
+// Print a consistent snapshot of both counters.
+void
+print_ctxtcnt(void)
+{
+  uint timer_count, switch_count;
+
+  acquire(&ctxtcnt_lock);
+  timer_count = timer_interrupt_count;
+  switch_count = context_switch_count;
+  release(&ctxtcnt_lock);
+
+  cprintf("Timer interrupts: %d\n", timer_count);
+  cprintf("Context switches: %d\n", switch_count);
+}

