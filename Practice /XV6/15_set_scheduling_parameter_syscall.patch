# Complete and test existing scheduling-parameter syscalls
# Apply after 612415074(1).diff_3 to a clean mit-pdos/xv6-public master checkout.
# This patch preserves the existing setpriority(int)/getpriority(void) ABI.

diff --git a/test_priority.c b/test_priority.c
--- a/test_priority.c
+++ b/test_priority.c
@@ -0,0 +1,22 @@
+#include "types.h"
+#include "stat.h"
+#include "user.h"
+
+int
+main(void)
+{
+  int old, p;
+  old = getpriority();
+  printf(1, "initial priority=%d\n", old);
+  for(p = 1; p <= 5; p++){
+    if(setpriority(p) < 0){
+      printf(2, "setpriority(%d) failed\n", p);
+      exit();
+    }
+    printf(1, "set priority=%d, getpriority=%d\n", p, getpriority());
+  }
+  if(setpriority(0) != -1 || setpriority(6) != -1)
+    printf(2, "invalid priority validation failed\n");
+  setpriority(old);
+  exit();
+}
