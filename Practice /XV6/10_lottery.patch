# Lottery scheduling
# Apply after 612415074(1).diff_3 to a clean mit-pdos/xv6-public master checkout.
# Each policy patch is an alternative: apply only one of 01..18.

diff --git a/proc.h b/proc.h
--- a/proc.h
+++ b/proc.h
@@ -51,1 +51,2 @@ struct proc {
   int priority;                // lets keep priority from 1 to 5
+  uint tickets; /* positive lottery tickets */

diff --git a/proc.c b/proc.c
--- a/proc.c
+++ b/proc.c
@@ -91,1 +91,2 @@ found:
   p->priority = 1; //lets just say the default priority is 1
+  p->tickets = 1;

diff --git a/proc.c b/proc.c
--- a/proc.c
+++ b/proc.c
@@ -320,33 +320,39 @@
 
 void
 scheduler(void)
 {
-  struct proc *p;
+  struct proc *p, *best;
   struct cpu *c = mycpu();
-
   c->proc = 0;
   for(;;){
-    // Enable interrupts on this processor.
     sti();
-
-    // Loop over process table looking for process to run.
     acquire(&ptable.lock);
+    uint total = 0, draw;
+    best = 0;
     for(p = ptable.proc; p < &ptable.proc[NPROC]; p++){
       if(p->state != RUNNABLE)
         continue;
-
-      // Switch to chosen process.  It is the process's job
-      // to release ptable.lock and then reacquire it
-      // before jumping back to us.
+      if(p->tickets > 0) total += p->tickets;
+    }
+    if(total > 0){
+      draw = next_random() % total;
+      best = 0;
+      for(p = ptable.proc; p < &ptable.proc[NPROC]; p++){
+        if(p->state != RUNNABLE || p->tickets == 0) continue;
+        if(draw < p->tickets){ best = p; break; }
+        draw -= p->tickets;
+      }
+    }
+    if(best != 0){
+      p = best;
+      
       c->proc = p;
       switchuvm(p);
       p->state = RUNNING;
       swtch(&(c->scheduler), p->context);
       switchkvm();
-
-      // Process is done running for now.
-      // It should have changed its p->state before coming back.
       c->proc = 0;
+      
     }
     release(&ptable.lock);
   }

diff --git a/proc.c b/proc.c
--- a/proc.c
+++ b/proc.c
@@ -25,1 +25,10 @@ static struct proc *initproc;
 static struct proc *initproc;
+static uint rng_state = 2463534242U;
+static uint
+next_random(void)
+{
+  rng_state ^= rng_state << 13;
+  rng_state ^= rng_state >> 17;
+  rng_state ^= rng_state << 5;
+  return rng_state;
+}
