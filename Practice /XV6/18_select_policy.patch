# Runtime scheduler policy selection
# Apply after 612415074(1).diff_3 to a clean mit-pdos/xv6-public master checkout.
# Each policy patch is an alternative: apply only one of 01..18.

diff --git a/proc.h b/proc.h
--- a/proc.h
+++ b/proc.h
@@ -51,1 +51,2 @@ struct proc {
   int priority;                // lets keep priority from 1 to 5
+  uint arrival_order; /* FIFO ordering */

diff --git a/proc.c b/proc.c
--- a/proc.c
+++ b/proc.c
@@ -91,1 +91,2 @@ found:
   p->priority = 1; //lets just say the default priority is 1
+  p->arrival_order = next_arrival_order++;

diff --git a/proc.c b/proc.c
--- a/proc.c
+++ b/proc.c
@@ -320,33 +320,40 @@
 
 void
 scheduler(void)
 {
-  struct proc *p;
+  struct proc *p, *best, *wrap_best;
   struct cpu *c = mycpu();
-
   c->proc = 0;
   for(;;){
-    // Enable interrupts on this processor.
     sti();
-
-    // Loop over process table looking for process to run.
     acquire(&ptable.lock);
+    
+    best = 0;
+    wrap_best = 0;
     for(p = ptable.proc; p < &ptable.proc[NPROC]; p++){
       if(p->state != RUNNABLE)
         continue;
-
-      // Switch to chosen process.  It is the process's job
-      // to release ptable.lock and then reacquire it
-      // before jumping back to us.
+      if(current_sched_policy == SCHED_RR) {
+        if(p->pid > rr_last_pid && (best == 0 || p->pid < best->pid)) best = p;
+        if(wrap_best == 0 || p->pid < wrap_best->pid) wrap_best = p;
+      } else if(current_sched_policy == SCHED_FCFS) {
+        if(best == 0 || p->arrival_order < best->arrival_order) best = p;
+      } else {
+        if(best == 0 || p->priority < best->priority || (p->priority == best->priority && p->pid < best->pid)) best = p;
+      }
+    }
+    if(current_sched_policy == SCHED_RR && best == 0) best = wrap_best;
+    if(best != 0){
+      p = best;
+      if(current_sched_policy == SCHED_RR) rr_last_pid = p->pid;
+      
       c->proc = p;
       switchuvm(p);
       p->state = RUNNING;
       swtch(&(c->scheduler), p->context);
       switchkvm();
-
-      // Process is done running for now.
-      // It should have changed its p->state before coming back.
       c->proc = 0;
+      
     }
     release(&ptable.lock);
   }

diff --git a/proc.h b/proc.h
--- a/proc.h
+++ b/proc.h
@@ -54,0 +55,1 @@ struct proc {
+enum sched_policy { SCHED_RR = 0, SCHED_FCFS = 1, SCHED_PRIORITY = 2 };

diff --git a/proc.c b/proc.c
--- a/proc.c
+++ b/proc.c
@@ -25,0 +26,3 @@ static struct proc *initproc;
+static uint next_arrival_order = 1;
+static int rr_last_pid = 0;
+int current_sched_policy = SCHED_RR;

diff --git a/syscall.h b/syscall.h
--- a/syscall.h
+++ b/syscall.h
@@ -23,1 +23,2 @@
 #define SYS_getpriority 23
+#define SYS_setschedpolicy 24

diff --git a/syscall.c b/syscall.c
--- a/syscall.c
+++ b/syscall.c
@@ -105,1 +105,2 @@
 extern int sys_uptime(void);
+extern int sys_setschedpolicy(void);
@@ -128,2 +129,3 @@
 [SYS_close]   sys_close,
+[SYS_setschedpolicy] sys_setschedpolicy,
 };

diff --git a/sysproc.c b/sysproc.c
--- a/sysproc.c
+++ b/sysproc.c
@@ -89,2 +89,15 @@ sys_uptime(void)
   return xticks;
 }
+
+int
+sys_setschedpolicy(void)
+{
+  extern int current_sched_policy;
+  int policy;
+  if(argint(0, &policy) < 0 || policy < 0 || policy > 2)
+    return -1;
+  acquire(&ptable.lock);
+  current_sched_policy = policy;
+  release(&ptable.lock);
+  return 0;
+}

diff --git a/user.h b/user.h
--- a/user.h
+++ b/user.h
@@ -25,1 +25,2 @@
 int getpriority(void);
+int setschedpolicy(int);

diff --git a/usys.S b/usys.S
--- a/usys.S
+++ b/usys.S
@@ -33,1 +33,2 @@
 SYSCALL(getpriority)
+SYSCALL(setschedpolicy)
